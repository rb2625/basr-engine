# Copy to .env.local and fill in. These match the values already in the
# repo root .env used by the Python pipeline.
#
# The service-role key is server-side ONLY (the browser never sees it - all
# pages read through /api/data). For a production public deployment, keep the
# key secret and set these in the Vercel project environment instead.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
